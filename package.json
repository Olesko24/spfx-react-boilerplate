{
  "name": "sp-webpart-template",
  "version": "4.0.0",
  "private": true,
  "engines": {
    "node": ">=22.14.0 <23.0.0 || >=24.0.0 <25.0.0 || >=26.0.0 <27.0.0"
  },
  "scripts": {
    "build": "npm-run-all tailwindcss build:spfx",
    "build:spfx": "heft test --clean --production && heft package-solution --production",
    "clean": "heft clean",
    "eject-webpack": "heft eject-webpack",
    "lint": "eslint src",
    "start": "npm-run-all tailwindcss -p tailwindcss:watch start:spfx",
    "start:spfx": "heft start --clean",
    "tailwindcss": "tailwindcss -i ./src/styles/tailwind.css -o ./src/styles/dist/tailwind.css --minify",
    "tailwindcss:watch": "tailwindcss -i ./src/styles/tailwind.css -o ./src/styles/dist/tailwind.css --watch --minify"
  },
  "dependencies": {
    "@fluentui/react": "^8.106.4",
    "@fluentui/react-components": "^9.75.3",
    "@fluentui/react-migration-v8-v9": "^9.10.26",
    "@microsoft/sp-component-base": "1.24.2",
    "@microsoft/sp-core-library": "1.24.2",
    "@microsoft/sp-lodash-subset": "1.24.2",
    "@microsoft/sp-office-ui-fabric-core": "1.24.2",
    "@microsoft/sp-property-pane": "1.24.2",
    "@microsoft/sp-webpart-base": "1.24.2",
    "@pnp/sp": "^4.23.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tslib": "2.3.1"
  },
  "devDependencies": {
    "@microsoft/eslint-config-spfx": "1.24.2",
    "@microsoft/eslint-plugin-spfx": "1.24.2",
    "@microsoft/sp-module-interfaces": "1.24.2",
    "@microsoft/spfx-heft-plugins": "1.24.2",
    "@microsoft/spfx-web-build-rig": "1.24.2",
    "@rushstack/heft": "1.3.2",
    "@tailwindcss/cli": "^4.3.5",
    "@types/jest": "30.0.0",
    "@types/react": "18.2.79",
    "@types/react-dom": "18.2.25",
    "@types/webpack-env": "~1.15.2",
    "css-loader": "~7.1.2",
    "eslint": "9.37.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "npm-run-all2": "^9.1.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.8.0"
  },
  "overrides": {
    "@rushstack/heft": "1.3.2",
    "qs": ">=6.15.2",
    "serialize-javascript": "^7.1.3",
    "uuid": ">=11.1.1"
  },
  "resolutions": {
    "@types/react": "18.2.79"
  }
}
